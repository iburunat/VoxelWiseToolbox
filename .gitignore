# Sphinx build output. The HTML is rebuilt by Read the Docs on every push,
# so committing it would mean a second, stale copy of the whole site.
_build/
source/_build/

# NOTE: source/modules/ and source/demos/ are deliberately NOT ignored.
# They are generated by tools/batch_generate.m, but Read the Docs has no
# MATLAB and cannot run it, so the generated .rst files must be committed or
# the published site has an empty function reference. Never hand-edit a file
# in those two folders: the next batch_generate run deletes it.

# MATLAB
*.asv
*.m~
*.autosave
slprj/
codegen/

# Compiled MEX binaries. The toolbox ships none; these would only ever be
# someone's local build of a bundled dependency.
*.mex
*.mexa64
*.mexmaci64
*.mexmaca64
*.mexw32
*.mexw64

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini

# Dropbox writes these beside the original when two machines touch a file.
# Sphinx reads every .rst it finds, so one left in source/ fails the build.
*conflicted copy*

# Python, for the docs toolchain
__pycache__/
*.py[cod]
.venv/
venv/
