    family-names: Burunat
    affiliation: "University of Jyväskylä"
  - given-names: Vinoo
    family-names: Alluri
    affiliation: "International Institute of Information Technology, Hyderabad"
  - given-names: Petri
    family-names: Toiviainen
    affiliation: "University of Jyväskylä"
version: 1.0.0
date-released: "2026-11-05"
doi: 10.5281/zenodo.19173637
license: MIT
repository-code: "https://github.com/iburunat/VoxelWise-Toolbox"
url: "https://voxelwisetoolbox.readthedocs.io"
keywords:
  - fMRI
  - neuroimaging
  - MATLAB
  - naturalistic paradigms
  - voxelwise analysis
  - intersubject correlation

preferred-citation:
  type: article
  title: "VoxelWise Toolbox: transparent and composable fMRI analysis in base MATLAB"
  authors:
